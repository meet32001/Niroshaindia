# ==============================================================================
# NIROSHA INDIA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# - NEVER commit actual production secrets to version control.
# - Variables prefixed with NEXT_PUBLIC_ are bundled into client-side JS.
# - All other variables are strictly server-only and must remain confidential.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase)
# ------------------------------------------------------------------------------
# [CLIENT-ACCESSIBLE]: REST endpoint URL for Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# [CLIENT-ACCESSIBLE]: Public anon key guarded by Postgres Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here"

# [SERVER-ONLY: STRICT SECRET]: Admin service role key (bypasses RLS). NEVER expose to client!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Clerk)
# ------------------------------------------------------------------------------
# [CLIENT-ACCESSIBLE]: Clerk frontend publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"

# [SERVER-ONLY: STRICT SECRET]: Clerk backend secret key
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"

# [SERVER-ONLY: STRICT SECRET]: Svix webhook signature secret for Clerk user synchronization
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_secret_here"

# [CLIENT-ACCESSIBLE]: Clerk Authentication Redirection URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/auth-callback"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/auth-callback"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ------------------------------------------------------------------------------
# 3. APPLICATION & CANONICAL URLS
# ------------------------------------------------------------------------------
# [CLIENT-ACCESSIBLE]: Canonical website URL (used for links, emails, and SEO)
NEXT_PUBLIC_APP_URL="https://niroshaindia.com"
NEXT_PUBLIC_BASE_URL="https://niroshaindia.com"

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (Resend)
# ------------------------------------------------------------------------------
# [SERVER-ONLY: STRICT SECRET]: Resend API key for VIP drops, support desk & newsletters
RESEND_API_KEY="re_your_resend_api_key_here"

# [SERVER-ONLY]: Verified sender email address
RESEND_FROM_EMAIL="Nirosha VIP <onboarding@resend.dev>"

# [SERVER-ONLY]: Administrator notification recipient email
ADMIN_NOTIFICATION_EMAIL="admin@yourdomain.com"

# [CLIENT-ACCESSIBLE]: Public-facing customer care email
NEXT_PUBLIC_SUPPORT_EMAIL="support@niroshaindia.com"

# ------------------------------------------------------------------------------
# 5. CONTENT MANAGEMENT (Sanity CMS)
# ------------------------------------------------------------------------------
# [CLIENT-ACCESSIBLE]: Sanity project configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id_here"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-24"

# [SERVER-ONLY: STRICT SECRET]: Sanity API token with read/write access (server-side only)
SANITY_API_TOKEN="sk_your_sanity_api_token_here"
SANITY_API_READ_TOKEN="sk_your_sanity_read_token_here"

# ------------------------------------------------------------------------------
# 6. PAYMENTS (Stripe / Razorpay)
# ------------------------------------------------------------------------------
# [SERVER-ONLY: STRICT SECRET]: Stripe API Secret Key
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"

# [SERVER-ONLY: STRICT SECRET]: Stripe Webhook Signing Secret
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"
